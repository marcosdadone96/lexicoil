# Copy to .env for local development — NEVER commit .env
# See SECURITY.md for rotation policy and incident checklist.

# ── Auth (REQUIRED) ───────────────────────────────────────────────────────────
# Signs session JWTs for email/password and guest flows. Use 48+ random bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=
# Session JWT: HttpOnly `lc_token` cookie (Secure on HTTPS, SameSite=Strict) + transitional JSON `token` field.
# Browser clients must use fetch(..., { credentials: 'include' }) against allowed origins.
# ALLOW_NETLIFY_PREVIEWS=true
# LEXICOIL_ALLOWED_ORIGINS=https://your-preview.netlify.app

# ── Netlify Blobs (seed reusable-parts pool) ──────────────────────────────────
# Required for: node scripts/seed-reusable-from-curated.mjs --apply
#              node scripts/seed-reusable-from-bank.mjs --apply
# NETLIFY_SITE_ID=        # Site settings → General → Site ID
# NETLIFY_API_TOKEN=      # User settings → Applications → Personal access token
# Local dev: run `netlify link` + `netlify dev` so function timeout matches production (60s).
# Deprecated alias — code falls back to this if AUTH_JWT_SECRET is unset; prefer AUTH_JWT_SECRET only.
# LEXICOIL_JWT_SECRET=

# ── Google Gemini (content batch generation — de/B1 bank) ───────────────────
# https://aistudio.google.com/apikey — activa facturación para generación en volumen
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPM=60
GEMINI_MAX_OUTPUT_TOKENS=8192
# Tier gratuito (sin facturación): baja RPM y activa límites diarios conservadores
# GEMINI_RPM=8          # default del limitador si no se define (≈10 RPM free tier; deja margen)
# GEMINI_RPD=240        # peticiones/día (free tier 2.5-flash ≈250; deja margen)
# Alternativa más cupo diario gratis: gemini-2.5-flash-lite
# Prompt compacto por defecto en API; GEMINI_FULL_PROMPT=1 usa el prompt largo
# GEMINI_TRANSLATE_TIMEOUT_MS=12000  # vocab freeTranslate per-request timeout (ms)

# ── Groq (Lesen T1/T2/T5 — clave gsk_…) ───────────────────────────────────────
# https://console.groq.com/ → API Keys
# npm run generate:lesen:groq:t125
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_TPM_LIMIT=12000
# GROQ_MAX_OUTPUT_TOKENS=4096
# GROQ_TPM_MARGIN=500

# ── xAI Grok (Lesen T1/T2/T5 — clave xai-…, distinto de Groq) ───────────────
# https://console.x.ai/ → API Keys
# npm run generate:lesen:grok:t125
XAI_API_KEY=
# XAI_MODEL=grok-3-fast
# XAI_TIMEOUT_MS=300000
# XAI_MAX_OUTPUT_TOKENS=8192

# ── Ollama local (Lesen batch generation — scripts/generate-lesen-ollama-t125.mjs) ─
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_TIMEOUT_MS=300000

# ── Offline batch generation provider (scripts/ — NOT production claude-chat) ─
# GEN_PROVIDER=claude          # claude | gemini (default: claude)
# CLAUDE_GEN_MODEL=claude-haiku-4-5   # higher quality: claude-sonnet-4-6
# CLAUDE_MAX_OUTPUT_TOKENS=8000       # floor; lesen T2/T3 auto-bump to 16384
# GEN_MAX_OUTPUT_TOKENS=16384         # optional hard cap for all jobs
# CLAUDE_BUDGET_USD=2.30              # hard spend cap for offline Claude generation

# ── Anthropic (REQUIRED for AI exam generation) ───────────────────────────────
# https://console.anthropic.com/ → API keys
ANTHROPIC_API_KEY=
# Default model for vocab/chat (non-exam)
CLAUDE_MODEL=claude-sonnet-4-6
# Exam generation model (chunked exams)
CLAUDE_EXAM_MODEL=claude-sonnet-4-6
# Semantic verify for AI-generated exams (required for B1 production — use Sonnet, not Haiku)
EXAM_ANSWER_KEY_VERIFY=1
CLAUDE_VERIFY_MODEL=claude-sonnet-4-6
# Topic/theme + CEFR coherence gate (recommended ON in production; ~1 Claude call per part)
# TOPIC_COHERENCE_GATE=1
# Minimum cumulative-level vocab coverage for ingest/cefr_gate (0–1). Default 0.55.
# CEFR_MIN_COVERAGE=0.55
# Optional: bypass Netlify AI Gateway JWT overwriting ANTHROPIC_API_KEY in local dev
# ANTHROPIC_API_KEY_DIRECT=sk-ant-...
# EXAM_ANSWER_KEY_MISMATCH_THRESHOLD=0.35

# ── Supabase (REQUIRED for auth + user data) ──────────────────────────────────
# Project Settings → API → URL and anon public key
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role secret — ONLY for Netlify Functions (server-side). NEVER expose to client.
# Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (REQUIRED for payments) ────────────────────────────────────────────
# Dashboard → Developers → API keys (secret key)
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → signing secret for checkout.session.completed
STRIPE_WEBHOOK_SECRET=
# Publishable key (client-safe; optional in .env if only used in Netlify UI)
# STRIPE_PUBLISHABLE_KEY=

# ── Resend (optional — Pro welcome email after payment) ───────────────────────
# RESEND_API_KEY=
# RESEND_FROM=LexiCoil <noreply@lexicoil.com>

# ── Admin (optional — manual Pro activation via admin-activate-pro) ───────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ADMIN_SECRET=

# ── AI credits & plans ───────────────────────────────────────────────────────
# Monthly recurring AI credit pools (reset on calendar month via applyMonthlyAiReset)
# AI_CREDITS_FREE=6
# AI_CREDITS_PRO=40
# AI_CREDITS_PRO_MAX=150
# Optional signup-month bonus on top of free base (default 0)
# AI_CREDITS_WELCOME_BONUS=0
#
# Stripe subscription prices (create in Dashboard — Pro €13/mo, Pro Max €24/mo)
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_PRO_MAX=
# Legacy alias for Pro price:
# STRIPE_PRICE_ID=
#
# One-off credit packs (S/M/L — create in Stripe Dashboard)
# STRIPE_PRICE_CREDITS_15=
# STRIPE_PRICE_CREDITS_40=
# STRIPE_PRICE_CREDITS_100=
# Legacy pack price IDs (auto-recharge migration fallback):
# STRIPE_PRICE_CREDITS_50=
# STRIPE_PRICE_CREDITS_150=
# STRIPE_PRICE_CREDITS_400=

# ── Site / CORS ───────────────────────────────────────────────────────────────
LEXICOIL_SITE_URL=https://www.lexicoil.com
LEXICOIL_ALLOWED_ORIGINS=https://www.lexicoil.com,https://lexicoil.com
# Legacy site URL fallback in code — prefer LEXICOIL_SITE_URL
# LEXILOOP_SITE_URL=https://www.lexicoil.com

# ── Dev / preview only ────────────────────────────────────────────────────────
# Allow *.netlify.app origins when true (do not enable in production)
# ALLOW_NETLIFY_PREVIEWS=true

# ── TTS (optional — listening audio cache) ────────────────────────────────────
# none | stub | polly | google | elevenlabs
# TTS_PROVIDER=none
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Comma-separated ElevenLabs voice IDs per language (multi-speaker Hören uses slots 0,1,2…)
# ELEVENLABS_VOICES_DE=pNInz6obpgDQGcFmaJgB,JBFqnCBsd6RMkjVDRZzb,onwK4e9ZLuTAKqWW03F9
#
# After editing Hören transcripts in data/exams/*.json, regenerate bundled MP3s:
#   npm run pregenerate:tts:served
# Verify cache coverage:
#   npm run verify:tts:served

# ── Pool strategy (served exams live in Netlify Blobs) ───────────────────────
# Strategy-A (direct): leave STRATEGY_B unset or '0'. AI exams pass structural validation
# and enter the pool without human review; moderation via admin disable/delete.
# STRATEGY_B=1 — pool only serves curated entries; POST requires provenance (curation pipeline).
# STRATEGY_B=0
#
# Client Strategy-A direct contribution (bypasses servable-level pool block for DE B1 etc.):
# In index.html / browser: window.LC_DIRECT_POOL = '1'
# LC_DIRECT_POOL=1
#
# Staging: expose exam levels marked "beta" in data/exams/availability.json (prod shows "live" only):
# LEXICOIL_SHOW_BETA_LEVELS=1
# Browser: window.LEXICOIL_SHOW_BETA_LEVELS = true

# ── E2E / timing tests (optional) ─────────────────────────────────────────────
# EXAM_CHUNK_LIMIT_MS=26000
