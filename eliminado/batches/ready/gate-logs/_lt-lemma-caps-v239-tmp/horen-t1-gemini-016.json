{
  "passages": [
    {
      "id": "gen-p-h1-8e7e4170-s1",
      "module": "horen",
      "teil": 1,
      "title": "Anmeldung Sportverein",
      "text": "Guten Tag, liebe Sportfreunde! Der Sportverein 'Aktiver Körper' informiert über die neuen Kurse. Die Anmeldung für unser beliebtes Schwimmseminar und den Yogakurs beginnt nächste Woche, am Freitag, den 15. Mai. Sie müssen sich persönlich in unserem Büro anmelden. Die Gebühr ist direkt bei der Anmeldung zu bezahlen. Für weitere Auskünfte rufen Sie uns bitte an. Wir freuen uns auf viele neue Mitglieder!",
      "passageVocab": [
        "sportverein",
        "anmeldung",
        "kurs",
        "gebühr",
        "mitglied"
      ],
      "topicTag": "Sport"
    },
    {
      "id": "gen-p-h1-8e7e4170-s2",
      "module": "horen",
      "teil": 1,
      "title": "Laufveranstaltung",
      "text": "Achtung, Läuferinnen und Läufer! Der diesjährige 'Stadtlauf am Fluss' findet am 10. Juni statt. Es ist ein großes nationales Event, das viele Sportler anzieht. Die Strecke ist zehn Kilometer lang und führt durch die schönsten Teile unserer Stadt. Die Startgebühr beträgt 25 Euro. Sie können sich bis zum 3. Juni online registrieren. Alle Teilnehmer erhalten ein T-Shirt und eine Medaille. Wir hoffen, Sie empfinden die Herausforderung als motivierend!",
      "passageVocab": [
        "läufer",
        "event",
        "strecke",
        "startgebühr",
        "teilnehmer"
      ],
      "topicTag": "Sport"
    },
    {
      "id": "gen-p-h1-8e7e4170-s3",
      "module": "horen",
      "teil": 1,
      "title": "Fitnessstudio Angebot",
      "text": "Hallo Sportbegeisterte! Das Fitnessstudio 'Fit & Gesund' hat ein tolles Angebot für Sie. Werden Sie jetzt Mitglied und trainieren Sie die ersten drei Monate gratis! Danach zahlen Sie nur 29 Euro pro Monat. Dieses Angebot gilt nur für Neukunden und ist bis Ende des Monats gültig. Kommen Sie vorbei und überzeugen Sie sich selbst. Unser Team berät Sie gerne. Wir freuen uns, wenn Sie sich bei uns wohlfühlen und den Sport genießen.",
      "passageVocab": [
        "fitnessstudio",
        "angebot",
        "mitglied",
        "neukunde",
        "team"
      ],
      "topicTag": "Sport"
    },
    {
      "id": "gen-p-h1-8e7e4170-s4",
      "module": "horen",
      "teil": 1,
      "title": "Kinderschwimmkurs",
      "text": "Liebe Eltern, aufgepasst! Die Anmeldung für unsere beliebten Kinderschwimmkurse beginnt am 1. September. Die Kurse sind für Kinder ab fünf Jahren geeignet. Wir bieten Anfänger- und Fortgeschrittenenkurse an. Die Plätze sind begrenzt, daher ist eine schnelle Anmeldung wichtig. Für internationale Familien steht bei der Informationsveranstaltung ein Übersetzer zur Verfügung, der alle Fragen beantworten kann. Der Unterricht findet im städtischen Hallenbad statt.",
      "passageVocab": [
        "eltern",
        "schwimmkurs",
        "anfänger",
        "fortgeschritten",
        "hallenbad"
      ],
      "topicTag": "Sport"
    },
    {
      "id": "gen-p-h1-8e7e4170-s5",
      "module": "horen",
      "teil": 1,
      "title": "Sportplatz Renovierung",
      "text": "Achtung, Sportler! Der Fußballplatz am Park muss wegen dringender Renovierungsarbeiten geschlossen werden. Die Arbeiten beginnen am 20. Juli und dauern voraussichtlich vier Wochen. In dieser Zeit ist der Platz nicht nutzbar. Wir bitten um Ihr Verständnis. Die Renovierung ist notwendig, da in der Nähe ein neues Wohnungsbauprojekt startet und der Platz modernisiert werden muss. Wir informieren Sie, sobald der Platz wieder geöffnet ist.",
      "passageVocab": [
        "fußballplatz",
        "renovierung",
        "arbeiten",
        "verständnis",
        "projekt"
      ],
      "topicTag": "Sport"
    }
  ],
