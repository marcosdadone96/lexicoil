    {
      "id": "gen-p-h1-eb3ea80f-s1",
      "module": "horen",
      "teil": 1,
      "title": "Durchsage Bahnhof",
      "text": "Achtung, liebe Fahrgäste! Eine wichtige Durchsage für den Regionalexpress 345 nach Hamburg. Dieser Zug fährt heute nicht wie geplant von Gleis 5, sondern von Gleis 8 ab. Die Abfahrtszeit bleibt um 10:15 Uhr. Bitte beachten Sie auch, dass es auf dieser Strecke zu kleineren Verspätungen kommen kann. Wir bitten um Ihr Verständnis und wünschen eine gute Reise.",
      "passageVocab": [
        "fahrgast",
        "gleis",
        "abfahrt",
        "verspätung"
      ],
      "topicTag": "Verkehr"
    },
    {
      "id": "gen-p-h1-eb3ea80f-s2",
      "module": "horen",
      "teil": 1,
      "title": "Anrufbeantworter Autowerkstatt",
      "text": "Guten Tag, hier ist die Autowerkstatt Lehmann. Wir rufen wegen Ihres Wagens an. Die Reparatur ist abgeschlossen. Sie können Ihr Fahrzeug ab morgen Vormittag zwischen 9 und 12 Uhr abholen. Bitte bringen Sie die Rechnung mit. Die Gesamtkosten betragen 350 Euro. Für weitere Fragen erreichen Sie uns während der Öffnungszeiten. Vielen Dank für Ihr Vertrauen.",
      "passageVocab": [
        "autowerkstatt",
        "reparatur",
        "fahrzeug",
        "abholung",
        "kosten"
      ],
      "topicTag": "Verkehr"
    },
    {
      "id": "gen-p-h1-eb3ea80f-s3",
      "module": "horen",
      "teil": 1,
      "title": "Radio-Tipp Nahverkehr",
      "text": "Liebe Zuhörerinnen und Zuhörer, hier kommt unser Tipp des Tages für eine entspannte Fahrt. Nutzen Sie doch öfter die öffentlichen Verkehrsmittel! Das spart nicht nur Geld, sondern ist auch gut für die Umwelt. Mit der neuen Monatskarte fahren Sie das ganze Wochenende kostenlos. Eine Anmeldung ist nicht nötig, einfach online kaufen. Ein echter Vorteil für die Nachhaltigkeit im Stadtverkehr.",
      "passageVocab": [
        "verkehrsmittel",
        "umwelt",
        "monatskarte",
        "vorteil",
        "nachhaltigkeit"
      ],
      "topicTag": "Verkehr"
    },
    {
      "id": "gen-p-h1-eb3ea80f-s4",
      "module": "horen",
      "teil": 1,
      "title": "Hinweis Straßenbau",
      "text": "Wichtiger Hinweis für alle Verkehrsteilnehmer im Bereich der Hauptstraße: Ab Montag beginnen dort größere Bauarbeiten. Die Hauptstraße wird für vier Wochen komplett gesperrt. Eine Umleitung ist ausgeschildert, bitte folgen Sie den gelben Pfeilen. Rechnen Sie mit längeren Fahrzeiten, besonders im Berufsverkehr. Wir bitten um Ihre Geduld und Verständnis für die notwendigen Maßnahmen.",
      "passageVocab": [
        "verkehrsteilnehmer",
        "baustelle",
        "umleitung",
        "sperrung",
        "fahrzeit"
      ],
      "topicTag": "Verkehr"
    },
    {
      "id": "gen-p-h1-eb3ea80f-s5",
      "module": "horen",
      "teil": 1,
      "title": "Ansage Fahrradverleih",
      "text": "Guten Tag, willkommen bei unserem neuen Fahrradverleih am Stadtpark! Sie können jetzt ganz einfach ein Fahrrad mieten. Die Anmeldung erfolgt direkt über unsere App. Die Gebühr beträgt 10 Euro pro Tag oder 30 Euro für das ganze Wochenende. Unsere Station ist täglich von 8 bis 20 Uhr geöffnet. Probieren Sie es aus und genießen Sie die Stadt auf zwei Rädern!",
      "passageVocab": [
        "fahrradverleih",
        "mieten",
        "app",
        "gebühr",
        "wochenende"
      ],
      "topicTag": "Verkehr"
    }
