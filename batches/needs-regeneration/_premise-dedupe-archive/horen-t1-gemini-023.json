  "passages": [
    {
      "id": "gen-p-h1-d26d570b-s1",
      "module": "horen",
      "teil": 1,
      "title": "Durchsage am Flughafen",
      "text": "Achtung, liebe Fluggäste! Wir bitten um Ihre Aufmerksamkeit. Der Flug LH 123 nach Rom, geplant für 10:30 Uhr, hat leider eine Verspätung. Die neue Abflugzeit ist 12:00 Uhr. Bitte begeben Sie sich nicht zu Gate B12, sondern zu Gate C7. Wir entschuldigen uns für die Unannehmlichkeiten und bitten um Ihr Verständnis. Informationen zu anschlussflügen erhalten Sie am Serviceschalter.",
      "passageVocab": [
        "fluggast",
        "verspätung",
        "abflugzeit",
        "gate",
        "serviceschalter"
      ],
      "topicTag": "Reisen"
    },
    {
      "id": "gen-p-h1-d26d570b-s2",
      "module": "horen",
      "teil": 1,
      "title": "Anrufbeantworter Reisebüro",
      "text": "Guten Tag, hier ist das Reisebüro 'Weltweit Reisen'. Sie sprechen mit Frau Richter. Ich rufe wegen Ihrer Buchung für die Reise nach Spanien an. Wir haben noch eine kleine Frage zu den Hotelpräferenzen. Bitte rufen Sie uns bis spätestens morgen Mittag unter 089 123456 zurück. Ihre Unterlagen sind fast fertig. Wir freuen uns auf Ihre Rückmeldung, Herr Lehmann. Vielen Dank und auf Wiederhören.",
      "passageVocab": [
        "reisebüro",
        "buchung",
        "hotelpräferenz",
        "unterlagen",
        "rückmeldung"
      ],
      "topicTag": "Reisen"
    },
    {
      "id": "gen-p-h1-d26d570b-s3",
      "module": "horen",
      "teil": 1,
      "title": "Radio-Tipp für Reisende",
      "text": "Liebe Zuhörerinnen und Zuhörer, hier kommt unser Tipp des Tages für umweltfreundliches Reisen. Denken Sie daran, öffentliche Verkehrsmittel zu nutzen, wann immer es geht. Ein leichterer Koffer spart auch Treibstoff. Unterstützen Sie kleine, lokale Geschäfte und Restaurants am Urlaubsort. Das hilft der Region und ist gut für die Nachhaltigkeit. So wird Ihr Urlaub nicht nur schön, sondern auch verantwortungsbewusst. Gute Reise!",
      "passageVocab": [
        "umweltfreundlich",
        "verkehrsmittel",
        "koffer",
        "urlaubsort",
        "nachhaltigkeit"
      ],
      "topicTag": "Reisen"
    },
    {
      "id": "gen-p-h1-d26d570b-s4",
      "module": "horen",
      "teil": 1,
      "title": "Hinweis im Hotel",
      "text": "Sehr geehrte Gäste, bitte beachten Sie folgenden Hinweis. Das Frühstück wird täglich von 7:00 bis 10:00 Uhr im Speisesaal serviert. Der Check-out ist bis 11:00 Uhr möglich. Falls Sie später abreisen möchten, können Sie Ihr Gepäck kostenlos an der Rezeption aufbewahren lassen. Für weitere Fragen steht Ihnen unser Team jederzeit gerne zur Verfügung. Wir wünschen Ihnen einen angenehmen Aufenthalt in unserem Hotel.",
      "passageVocab": [
        "frühstück",
        "speisesaal",
        "check-out",
        "gepäck",
        "rezeption"
      ],
      "topicTag": "Reisen"
    },
    {
      "id": "gen-p-h1-d26d570b-s5",
      "module": "horen",
      "teil": 1,
      "title": "Ansage im Zug",
      "text": "Willkommen an Bord, liebe Reisende. Unser nächster Halt ist Leipzig Hauptbahnhof. Dort haben Sie Anschluss an Regionalzüge in Richtung Dresden und Halle. Der Speisewagen befindet sich im Wagen 7 und ist bis zur Endstation geöffnet. Wir erreichen Leipzig pünktlich um 15:45 Uhr. Bitte vergessen Sie beim Aussteigen keine persönlichen Gegenstände. Wir wünschen Ihnen eine angenehme Weiterreise.",
      "passageVocab": [
        "halt",
        "anschluss",
        "speisewagen",
        "endstation",
        "gegenstände"
      ],
      "topicTag": "Reisen"
    }
