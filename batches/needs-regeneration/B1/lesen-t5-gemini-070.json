      "teil": 5,
      "type": "multiple_choice",
      "question": "Bis wann kann man in der Mensa Essen bekommen?",
      "options": [
        "a) Bis 11:30 Uhr, wenn man vorbestellt hat.",
        "b) Bis 14:00 Uhr, aber nur montags bis freitags.",
        "c) Bis 13:45 Uhr an Wochentagen."
      ],
      "correct": "c",
