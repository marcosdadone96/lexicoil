      "audio": [
        {
          "speaker": "Lena",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Hallo Max! Wie geht es dir? Was machst du diese Woche?"
        },
        {
          "speaker": "Max",
          "voiceId": "de-DE-ConradNeural",
          "text": "Hallo Lena! Gut, danke. Ich habe viel zu tun. Am Montag muss ich meine Reiseunterlagen für den Urlaub nächste Woche sortieren."
        },
        {
          "speaker": "Lena",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Ah, schön! Wohin geht es? Ich habe am Dienstag einen Termin im Reisebüro für eine Zugreise."
        },
        {
          "speaker": "Max",
          "voiceId": "de-DE-ConradNeural",
          "text": "Ich fahre nach Italien! Am Dienstag packe ich meinen Koffer. Am Mittwoch lasse ich mein Fahrrad reparieren."
        },
        {
          "speaker": "Lena",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Fahrrad reparieren, gute Idee! Ich habe am Mittwoch einen Online-Sprachkurs für Spanisch."
        },
        {
          "speaker": "Max",
          "voiceId": "de-DE-ConradNeural",
          "text": "Super! Am Donnerstag besuche ich Freunde für Reisetipps."
        },
        {
          "speaker": "Lena",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Ich muss am Donnerstag meine Fahrkarte abholen."
        },
        {
          "speaker": "Max",
          "voiceId": "de-DE-ConradNeural",
          "text": "Und am Freitag? Ich putze meine Wohnung, bevor ich wegfahre."
        },
        {
          "speaker": "Lena",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Ich gehe am Freitag in die Bibliothek, um einen Reiseführer auszuleihen."
        }
      ]
    }
