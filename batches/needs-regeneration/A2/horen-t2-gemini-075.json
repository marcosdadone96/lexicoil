          "speaker": "Tom",
          "voiceId": "de-DE-ConradNeural",
          "text": "Hallo Katja! Wie geht es dir? Hast du schon Pläne für die Woche?"
        },
        {
          "speaker": "Katja",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Hallo Tom! Mir geht es gut. Ja, ich habe schon ein paar Ideen."
        },
        {
          "speaker": "Tom",
          "voiceId": "de-DE-ConradNeural",
          "text": "Erzähl mal!"
        },
        {
          "speaker": "Katja",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Am Dienstag treffe ich mich mit Freunden in einem Café. Wir wollen uns einfach ausruhen."
        },
        {
          "speaker": "Tom",
          "voiceId": "de-DE-ConradNeural",
          "text": "Das klingt gemütlich! Am Montag besuche ich das neue Kunstmuseum. Es ist sehr interessant."
        },
        {
          "speaker": "Katja",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Oh, gute Idee! Ich muss am Donnerstag unbedingt meinen Deutschkurs besuchen. Ich habe bald eine Prüfung."
        },
        {
          "speaker": "Tom",
          "voiceId": "de-DE-ConradNeural",
          "text": "Viel Erfolg! Ich gehe am Mittwoch ins Fitnessstudio. Ich muss wieder Sport machen, sonst werde ich noch faul."
        },
        {
          "speaker": "Katja",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Haha! Und was machst du am Freitag?"
        },
        {
          "speaker": "Tom",
          "voiceId": "de-DE-ConradNeural",
          "text": "Am Freitagabend gehe ich ins Kino. Es gibt einen neuen Film."
        },
        {
          "speaker": "Katja",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Super! Ich habe noch nichts für Freitag."
        }
      ]
    }
