      "audio": [
        {
          "speaker": "Anna",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Hallo Tom! Wie geht es dir? Hast du schon Pläne für die nächste Woche?"
        },
        {
          "speaker": "Tom",
          "voiceId": "de-DE-ConradNeural",
          "text": "Hallo Anna! Mir geht es gut, danke. Ja, ich habe schon ein paar Ideen. Am Montag fahre ich mit dem Fahrrad zum See. Das ist meine Lieblings-Freizeitaktivität."
        },
        {
          "speaker": "Anna",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Oh, schön! Ich habe am Dienstag meinen Deutschkurs. Das ist wichtig für mich."
        },
        {
          "speaker": "Tom",
          "voiceId": "de-DE-ConradNeural",
          "text": "Klar! Und am Mittwoch treffe ich ein paar Freunde in der Stadt. Wir wollen zusammen Kaffee trinken."
        },
        {
          "speaker": "Anna",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Gemütlich! Ich muss am Donnerstagabend kochen. Meine Familie kommt zu Besuch."
        },
        {
          "speaker": "Tom",
          "voiceId": "de-DE-ConradNeural",
          "text": "Das klingt lecker! Und am Freitag? Ich gehe am Freitag ins Kino. Es gibt einen neuen Film."
        },
        {
          "speaker": "Anna",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Ach, wirklich? Ich habe am Freitag nichts Besonderes vor. Vielleicht komme ich mit!"
        }
      ]
    }
