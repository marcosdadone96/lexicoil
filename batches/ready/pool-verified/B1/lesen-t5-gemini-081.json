      "teil": 5,
      "type": "multiple_choice",
      "question": "Wann können Mitarbeiter warmes Essen in der Mensa bekommen?",
      "options": [
        "a) Von 11:30 Uhr bis 14:00 Uhr.",
        "b) Zwischen 12:00 Uhr und 13:30 Uhr.",
        "c) Nur am Vormittag bis 11:30 Uhr."
      ],
      "correct": "b",
      "correctAnswer": "b",
      "explanation": "Die Mensa serviert das warme Mittagessen nur in dem Zeitfenster zwischen 12:00 Uhr und 13:30 Uhr.",
      "passageId": "gen-l5-9f555b32",
