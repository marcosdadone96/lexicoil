{
  "passages": [
    {
      "id": "gen-p-h1-e837d5cb-s1",
      "module": "horen",
      "teil": 1,
      "title": "Durchsage Supermarkt",
      "text": "Liebe Kundinnen und Kunden, einen Moment Aufmerksamkeit bitte! Heute haben wir ein besonderes Angebot für Sie in unserer Obst- und Gemüseabteilung. Frische Bio-Äpfel aus der Region kosten nur 1,99 Euro pro Kilo. Dieses Angebot gilt nur heute bis Ladenschluss. Nutzen Sie den Vorteil für Ihre gesunde Ernährung. Wir freuen uns auf Ihren Einkauf und wünschen Ihnen einen angenehmen Tag.",
      "passageVocab": [
        "kunde",
        "angebot",
        "vorteil",
        "ernährung"
      ],
      "topicTag": "Ernährung"
    },
    {
      "id": "gen-p-h1-e837d5cb-s2",
      "module": "horen",
      "teil": 1,
      "title": "Anrufbeantworter Ernährungsberatung",
      "text": "Guten Tag, hier ist Frau Braun von der Ernährungsberatung. Ich rufe Sie wegen unseres Termins am kommenden Dienstag an. Leider muss ich diesen verschieben. Bitte rufen Sie mich zurück, um einen neuen Termin zu vereinbaren. Es betrifft auch die Unterlagen, die ich Ihnen noch schicken wollte. Meine Nummer ist 089 123456. Vielen Dank für Ihr Verständnis. Ich hoffe, wir finden bald eine neue Zeit.",
      "passageVocab": [
        "beratung",
        "termin",
        "unterlage",
        "nummer"
      ],
      "topicTag": "Ernährung"
    },
    {
      "id": "gen-p-h1-e837d5cb-s3",
      "module": "horen",
      "teil": 1,
      "title": "Radio-Tipp gesunde Ernährung",
      "text": "Willkommen zu unserem kurzen Alltagstipp für eine gesunde Ernährung! Viele Menschen haben morgens wenig Zeit, aber ein gutes Frühstück ist wichtig. Bereiten Sie doch abends schon Haferflocken mit Obst und Nüssen vor. Stellen Sie es über Nacht in den Kühlschrank. So haben Sie am nächsten Morgen ein schnelles und gesundes Essen. Das ist eine einfache Aufgabe, die Ihnen den Start in den Tag angenehm macht.",
      "passageVocab": [
        "alltagstipp",
        "frühstück",
        "aufgabe",
        "essen"
      ],
      "topicTag": "Ernährung"
    },
    {
      "id": "gen-p-h1-e837d5cb-s4",
      "module": "horen",
      "teil": 1,
      "title": "Hinweis Restaurant",
      "text": "Liebe Gäste, bitte beachten Sie folgenden Hinweis zu unserem Mittagsangebot. Ab dieser Woche bieten wir täglich eine vegetarische Option an, die auch vegan zubereitet werden kann. Fragen Sie unser Personal nach den Zutaten, falls Sie Allergien haben. Wir legen Wert auf frische Lebensmittel aus der Region. Unser Küchenteam freut sich darauf, Ihnen neue, gesunde Gerichte zu servieren. Guten Appetit!",
      "passageVocab": [
        "gast",
        "hinweis",
        "angebot",
        "lebensmittel"
      ],
      "topicTag": "Ernährung"
    },
    {
      "id": "gen-p-h1-e837d5cb-s5",
      "module": "horen",
      "teil": 1,
      "title": "Ansage Kochkurs",
      "text": "Achtung, eine wichtige Information für alle Interessierten an unseren Kochkursen! Der neue Kurs 'Gesunde Küche für Anfänger' startet am 15. Oktober. Die Anmeldung ist ab sofort online möglich oder persönlich in unserem Büro. Die Gebühr beträgt 75 Euro und beinhaltet alle Lebensmittel. Bitte beachten Sie, dass die Teilnehmerzahl begrenzt ist. Sichern Sie sich schnell einen Platz für diesen beliebten Kurs zur gesunden Ernährung.",
      "passageVocab": [
        "kurs",
        "anmeldung",
        "gebühr",
        "küche"
      ],
      "topicTag": "Ernährung"
    }
  ],
