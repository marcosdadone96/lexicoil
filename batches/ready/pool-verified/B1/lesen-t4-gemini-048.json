  "passages": [
    {
      "id": "gen-l4-1da22e88",
      "module": "lesen",
      "teil": 4,
      "title": "Forum: Vegetarisches Mittagessen in Kantinen – ja oder nein?",
      "text": "In vielen Kantinen wird über eine wichtige Änderung gesprochen: Es soll nur noch vegetarisches Mittagessen angeboten werden. Die Stadtverwaltung möchte so eine gesündere Ernährung fördern und auch an Nachhaltigkeit denken. Viele Mitarbeiter und Besucher haben dazu eine klare Meinung. Lesen Sie die verschiedenen Ansichten und entscheiden Sie, ob die Personen den Vorschlag unterstützen.",
      "topicTag": "Ernährung",
      "lang": "de",
      "level": "B1"
    }
  ],
  "questions": [
    {
      "id": "gen-q-4-1da22e88-4",
      "module": "lesen",
      "teil": 4,
      "type": "ja_nein",
      "question": "Ist Sofia für den Vorschlag?",
      "options": [
        "a) Ja",
        "b) Nein"
      ],
      "correct": "Nein",
      "correctAnswer": "Nein",
      "explanation": "Sofia möchte Fleisch essen und sieht keine gute Lösung, wenn die Kantine nur vegetarisches Essen anbietet.",
      "signText": "Fleisch gehört für mich zu einer guten Mahlzeit dazu. Wenn es nur vegetarisch gibt, werde ich meine Familie bitten, mir etwas mitzubringen. Das ist keine gute Lösung. Ich lehne den Vorschlag ab.",
      "passageId": "gen-l4-1da22e88",
      "lang": "de",
      "level": "B1",
      "topicTags": [
        "Ernährung"
      ]
    },
