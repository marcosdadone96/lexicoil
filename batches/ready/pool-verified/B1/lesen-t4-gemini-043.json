{
  "passages": [
    {
      "id": "gen-l4-48efb5d9",
      "module": "lesen",
      "teil": 4,
      "title": "Forum: Vier-Tage-Woche im Büro – eine gute Idee?",
      "text": "In vielen Firmen wird über neue Arbeitsmodelle gesprochen. Ein Vorschlag, der oft diskutiert wird, ist die Einführung einer Vier-Tage-Woche. Das bedeutet, dass alle Kollegen nur vier Tage pro Woche im Büro arbeiten müssen. Dies soll die Entspannung fördern und die Organisation der Arbeit verbessern. Wir haben einige Meinungen dazu gesammelt. Lesen Sie die Beiträge und entscheiden Sie, ob die Person den Vorschlag unterstützt.",
      "lang": "de",
      "level": "B1",
      "topicTag": "Arbeit"
    }
  ],
  "questions": [
    {
      "id": "gen-q-4-48efb5d9-2",
      "module": "lesen",
      "teil": 4,
      "type": "ja_nein",
      "question": "Ist Lukas für den Vorschlag?",
      "options": [
        "a) Ja",
        "b) Nein"
      ],
      "correct": "Nein",
      "correctAnswer": "Nein",
      "explanation": "Lukas befürchtet, dass die Qualität der Arbeit unter der kürzeren Woche leiden könnte, da sein Team viele Projekte hat.",
      "signText": "Mehr Freizeit klingt gut, aber ich denke, dass es für unser Team schwierig wird. Wir haben viele Projekte, die volle fünf Tage brauchen. Die Qualität der Arbeit könnte leiden. Für mich ist der Vorschlag nicht gut.",
      "passageId": "gen-l4-48efb5d9",
