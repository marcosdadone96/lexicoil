  "questions": [
    {
      "id": "gen-q-sp-t1-21ad5163-q1",
      "module": "sprechen",
      "lang": "de",
      "level": "B1",
      "type": "planungsaufgabe",
      "teil": 1,
      "question": "Sie möchten zusammen mit Ihrem Partner/Ihrer Partnerin ein kleines Kulturfest in Ihrer Stadt organisieren. Planen Sie das Fest gemeinsam. Sprechen Sie über die folgenden Punkte:\n\nDatum und geeigneter Ort für das Fest\nIdeen für das Programm (Musik, Essen, Aktivitäten)\nBudgetplanung: Was darf das Fest kosten?\nWerbung und wie Sie die Leute informieren können\nmögliche Schwierigkeiten, wie zum Beispiel Umgang mit Beschwerden von Anwohnern oder unerwarteten Problemen bei der Organisation\n\nMachen Sie Vorschläge, reagieren Sie auf die Vorschläge Ihres Partners/Ihrer Partnerin und einigen Sie sich.",
      "correct": "rubric",
      "correctAnswer": "rubric",
      "options": [],
      "explanation": "In diesem Teil des Sprechens geht es um Ihre Fähigkeit, eine Aufgabe gemeinsam zu planen, Vorschläge zu machen, darauf zu reagieren und sich zu einigen. Wichtig sind hierbei die Flüssigkeit des Sprechens, die korrekte Grammatik, der passende Wortschatz und die Aufgabenbewältigung.",
      "skills": [
        "speaking"
      ],
      "language": "de",
      "examType": "goethe",
      "difficulty": 5,
