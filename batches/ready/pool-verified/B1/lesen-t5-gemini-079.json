  "passages": [
    {
      "id": "gen-l5-b7f628e2",
      "module": "lesen",
      "teil": 5,
      "title": "Regeln im Reise- und Sportzentrum \"Weltentdecker\"",
      "text": "Regeln im Reise- und Sportzentrum \"Weltentdecker\"\n\nÖffnungszeiten: Das Zentrum ist täglich von 8:00 bis 22:00 Uhr geöffnet. Das Schwimmbad schließt um 21:00 Uhr. Am Wochenende beginnen alle Aktivitäten erst um 9:00 Uhr.\nKursanmeldung: Für Reisevorbereitungskurse ist eine Anmeldung zwei Wochen vor Beginn nötig. Eine Stornierung ist bis drei Tage vorher kostenlos. Danach kostet es 15 Euro.\nSchwimmbadnutzung: Kinder unter 12 Jahren dürfen nur mit einem Erwachsenen ins Wasser. Badekappen sind Pflicht.\nParkplatz: Kostenlose Parkplätze für Besucher sind vor dem Zentrum. Reisebusse und Wohnmobile müssen auf dem großen Parkplatz hinter dem Gebäude stehen.\nRaumnutzung: Seminarräume für Reisevorträge oder Gruppentreffen kosten 20 Euro pro Stunde. Die Küchennutzung kostet zusätzlich 10 Euro. Reservierung über die Organisation an der Rezeption.\nGepäck und Fahrräder: Koffer und großes Reisegepäck können in Schließfächern im Eingangsbereich verstaut werden. Fahrräder für Radreisen müssen im Fahrradraum abgestellt werden, nicht im Flur.\nRuhezeiten: In Ruheräumen und in der Bibliothek ist absolute Ruhe von 13:00 bis 15:00 Uhr und ab 20:00 Uhr einzuhalten.",
      "lang": "de",
      "level": "B1",
      "topicTag": "Reisen"
    }
  ],
  "questions": [
    {
      "id": "gen-q-5-b7f628e2-1",
      "module": "lesen",
      "teil": 5,
      "type": "multiple_choice",
      "question": "Wann kann man das Schwimmbad im \"Weltentdecker\" Zentrum maximal nutzen?",
      "options": [
        "a) Bis 22:00 Uhr, wie das gesamte Zentrum.",
        "b) Bis 21:00 Uhr, auch am Wochenende.",
        "c) Nur bis 20:00 Uhr, da danach Ruhezeiten sind."
      ],
      "correct": "b",
      "correctAnswer": "b",
      "explanation": "Das Schwimmbad schließt um 21:00 Uhr, während das Zentrum bis 22:00 Uhr geöffnet ist. Die Wochenendzeiten betreffen den Beginn der Aktivitäten, nicht die Schließzeit des Schwimmbads.",
      "passageId": "gen-l5-b7f628e2",
      "lang": "de",
      "level": "B1",
      "topicTags": [
        "Reisen"
      ]
    },
    {
      "id": "gen-q-5-b7f628e2-2",
      "module": "lesen",
      "teil": 5,
      "type": "multiple_choice",
      "question": "Was passiert, wenn man einen Reisevorbereitungskurs nur zwei Tage vor Beginn absagt?",
      "options": [
        "a) Man muss den gesamten Kurspreis bezahlen.",
        "b) Die Absage ist kostenlos, wenn man dies der Organisation mitteilt.",
        "c) Es muss eine Gebühr von 15 Euro bezahlt werden."
      ],
      "correct": "c",
      "correctAnswer": "c",
      "explanation": "Laut den Regeln ist eine Stornierung zwei Tage vor Kursbeginn nicht mehr kostenlos. In diesem Fall muss man eine Gebühr von 15 Euro bezahlen.",
      "passageId": "gen-l5-b7f628e2",
      "lang": "de",
      "level": "B1",
      "topicTags": [
        "Reisen"
      ]
    },
    {
      "id": "gen-q-5-b7f628e2-3",
      "module": "lesen",
      "teil": 5,
      "type": "multiple_choice",
      "question": "Wo dürfen Besucher ihre Fahrzeuge abstellen und was gilt für größere Fahrzeuge?",
      "options": [
        "a) Besucher parken gratis vorn; Busse und Wohnmobile müssen hinten parken.",
        "b) Für alle Fahrzeugtypen gibt es nur kostenpflichtige Plätze hinter dem Gebäude.",
        "c) Jedes Fahrzeug darf gratis direkt vor dem Eingang parken, auch Reisebusse."
      ],
      "correct": "a",
      "correctAnswer": "a",
      "explanation": "Besucher können ihre Fahrzeuge gratis vor dem Zentrum parken. Große Fahrzeuge wie Reisebusse und Wohnmobile müssen aber den Parkplatz hinter dem Gebäude nutzen.",
      "passageId": "gen-l5-b7f628e2",
      "lang": "de",
      "level": "B1",
      "topicTags": [
        "Reisen"
      ]
    },
    {
      "id": "gen-q-5-b7f628e2-4",
      "module": "lesen",
      "teil": 5,
      "type": "multiple_choice",
      "question": "Was muss man für einen Raum mit Kochmöglichkeit bezahlen, wenn man ihn eine Stunde nutzen möchte, und wie meldet man sich an?",
      "options": [
        "a) 20 Euro pro Stunde für den Raum; die Kochmöglichkeit ist ohne Aufpreis enthalten.",
        "b) 30 Euro insgesamt, und die Anmeldung für Seminarräume erfolgt nur online über das Portal.",
        "c) 30 Euro, und man muss sich an der Rezeption melden."
      ],
      "correct": "c",
      "correctAnswer": "c",
      "explanation": "Ein Seminarraum kostet 20 Euro pro Stunde und die Küchennutzung zusätzlich 10 Euro, also insgesamt 30 Euro. Die Reservierung oder Anmeldung erfolgt über die Organisation an der Rezeption.",
      "passageId": "gen-l5-b7f628e2",
