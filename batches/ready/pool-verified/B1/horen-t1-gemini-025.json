{
  "passages": [
    {
      "id": "gen-p-h1-1c0a7a53-s1",
      "module": "horen",
      "teil": 1,
      "title": "Durchsage Bahnhof",
      "text": "Achtung, liebe Reisende! Eine wichtige Durchsage für alle, die zum Musikfestival nach Wiesenbach fahren möchten. Es gibt einen Sonderzug, der direkt zum Festivalgelände fährt. Die Abfahrt ist am Samstag um 10:00 Uhr von Gleis 5. Eine vorherige Anmeldung ist unbedingt erforderlich, da die Plätze begrenzt sind. Bitte melden Sie sich bis spätestens Donnerstagabend online auf unserer Webseite an. Die Fahrkarten erhalten Sie dann direkt im Zug. Wir wünschen eine gute Reise und viel Spaß beim Festival!",
      "passageVocab": [
        "reisende",
        "sonderzug",
        "anmeldung",
        "fahrkarte",
        "festival"
      ],
      "topicTag": "Reisen"
    },
    {
      "id": "gen-p-h1-1c0a7a53-s2",
      "module": "horen",
      "teil": 1,
      "title": "Anrufbeantworter Reisebüro",
      "text": "Guten Tag, hier ist das Reisebüro Weltweit. Sie sprechen mit Frau Seidel. Ich rufe wegen Ihrer Reiseunterlagen für Italien an, Herr Keller. Ihre Dokumente sind fertig und können ab sofort bei uns abgeholt werden. Wir haben montags bis freitags von 9 bis 18 Uhr geöffnet. Falls Sie die Unterlagen lieber per Post erhalten möchten, geben Sie uns bitte Bescheid. Rufen Sie uns einfach zurück. Wir freuen uns auf Ihren Anruf und wünschen Ihnen eine schöne Reise!",
      "passageVocab": [
        "reisebüro",
        "reiseunterlagen",
        "abholung",
        "öffnungszeiten",
        "post"
      ],
      "topicTag": "Reisen"
    },
    {
      "id": "gen-p-h1-1c0a7a53-s3",
      "module": "horen",
      "teil": 1,
      "title": "Radio-Tipp nachhaltiges Reisen",
      "text": "Willkommen zu unserem heutigen Reisetipp! Möchten Sie umweltfreundlicher unterwegs sein? Dann achten Sie auf nachhaltiges Reisen. Nutzen Sie öffentliche Verkehrsmittel statt des Autos, besonders bei kürzeren Strecken. Packen Sie Ihren Koffer nicht zu voll, denn weniger Gewicht spart Treibstoff. Versuchen Sie, lokale Produkte zu kaufen und kleine Geschäfte zu unterstützen. Das hat viele Vorteile für die Region und die Umwelt. So wird Ihre Reise zu einem echten Erlebnis mit gutem Gewissen!",
      "passageVocab": [
        "reisetipp",
        "nachhaltigkeit",
        "verkehrsmittel",
        "koffer",
        "vorteil"
      ],
      "topicTag": "Reisen"
    },
    {
      "id": "gen-p-h1-1c0a7a53-s4",
      "module": "horen",
      "teil": 1,
      "title": "Hinweis Flughafen",
      "text": "Wichtiger Hinweis für alle Passagiere am Flughafen. Bitte bereiten Sie sich auf die Sicherheitskontrolle vor. Flüssigkeiten im Handgepäck dürfen nur in Behältern bis 100 Milliliter mitgeführt werden und müssen in einem durchsichtigen Beutel sein. Nehmen Sie bitte auch alle elektronischen Geräte wie Laptops und Tablets aus Ihrem Koffer und legen Sie diese separat in die Kontrollwanne. Vielen Dank für Ihre Mithilfe und einen angenehmen Flug!",
      "passageVocab": [
        "passagiere",
        "flughafen",
        "sicherheitskontrolle",
        "flüssigkeiten",
        "handgepäck"
      ],
      "topicTag": "Reisen"
    },
    {
      "id": "gen-p-h1-1c0a7a53-s5",
      "module": "horen",
      "teil": 1,
      "title": "Ansage Hotel",
      "text": "Liebe Gäste, herzlich willkommen in unserem Hotel. Wir möchten Sie auf unseren täglichen Stadtrundgang aufmerksam machen. Er startet jeden Morgen um 9:30 Uhr direkt vor der Rezeption. Unser Guide, Herr Neumann, zeigt Ihnen die wichtigsten Sehenswürdigkeiten und erzählt interessante Geschichten über die Stadt. Die Teilnahme kostet 15 Euro pro Person. Eine Anmeldung ist bis zum Vorabend an der Rezeption erforderlich. Nutzen Sie diese Gelegenheit, um unsere schöne Stadt kennenzulernen!",
      "passageVocab": [
        "gäste",
        "hotel",
        "stadtrundgang",
        "rezeption",
        "anmeldung"
      ],
      "topicTag": "Reisen"
    }
  ],
