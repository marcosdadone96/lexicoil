      "audio": [
        {
          "speaker": "Lena",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Hallo Max! Wie geht es dir? Hast du schon Pläne für die nächste Woche?"
        },
        {
          "speaker": "Max",
          "voiceId": "de-DE-ConradNeural",
          "text": "Hallo Lena! Mir geht es gut. Am Montag muss ich mein Fahrrad reparieren. Ein kleines Projekt."
        },
        {
          "speaker": "Lena",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Oh, das klingt nach Arbeit! Ich habe am Montagabend einen Deutschkurs."
        },
        {
          "speaker": "Max",
          "voiceId": "de-DE-ConradNeural",
          "text": "Und Dienstag? Ich treffe mich mit Freunden im Café."
        },
        {
          "speaker": "Lena",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Dienstag gehe ich ins Fitnessstudio. Am Mittwoch besuche ich eine Kunstausstellung im Museum."
        },
        {
          "speaker": "Max",
          "voiceId": "de-DE-ConradNeural",
          "text": "Ein Museum? Interessant! Ich gehe am Donnerstag ins Kino. Es gibt einen neuen Film."
        },
        {
          "speaker": "Lena",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Kino ist toll! Ich habe am Donnerstagabend keine Pläne, vielleicht lese ich ein Buch."
        },
        {
          "speaker": "Max",
          "voiceId": "de-DE-ConradNeural",
          "text": "Und Freitag? Ich muss noch einkaufen gehen."
        },
        {
          "speaker": "Lena",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Am Freitagabend koche ich für meine Familie."
        }
      ]
    }
