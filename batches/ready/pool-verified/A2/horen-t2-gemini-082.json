      "audio": [
        {
          "speaker": "Mia",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Hallo Felix! Wie geht's? Was machst du diese Woche?"
        },
        {
          "speaker": "Felix",
          "voiceId": "de-DE-ConradNeural",
          "text": "Hallo Mia! Mir geht's gut, danke. Ich habe schon ein paar Pläne."
        },
        {
          "speaker": "Mia",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Erzähl mal!"
        },
        {
          "speaker": "Felix",
          "voiceId": "de-DE-ConradNeural",
          "text": "Am Montagabend gehe ich ins Kino. Ich möchte einen neuen Film sehen."
        },
        {
          "speaker": "Mia",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Oh, schön! Ich muss am Dienstag für die Uni lernen. Ich habe bald eine Prüfung."
        },
        {
          "speaker": "Felix",
          "voiceId": "de-DE-ConradNeural",
          "text": "Viel Erfolg! Am Mittwoch habe ich meinen Deutschkurs. Das ist immer interessant."
        },
        {
          "speaker": "Mia",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Ja, Deutsch ist wichtig. Ich gehe am Donnerstag einkaufen. Ich brauche noch Lebensmittel für das Wochenende."
        },
        {
          "speaker": "Felix",
          "voiceId": "de-DE-ConradNeural",
          "text": "Klar. Und am Freitag treffe ich ein paar Freunde in einem Café. Wir wollen über unsere Freizeit sprechen."
        },
        {
          "speaker": "Mia",
          "voiceId": "de-DE-KatjaNeural",
          "text": "Das klingt nach einer vollen Woche!"
        }
      ]
