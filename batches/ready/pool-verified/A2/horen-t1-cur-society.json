{
  "passages": [
    {
      "id": "de-a2-p-horen-t1-einkaufen-markt-01-s4",
      "module": "horen",
      "teil": 1,
      "level": "A2",
      "title": "Text 4",
      "text": "Liebe Kunden und Kundinnen! Das Geschäft König bleibt nächste Woche geschlossen. Wir machen Urlaub vom 15. bis 22. Mai. Ab dem 23. Mai sind wir wieder für Sie da. Vielen Dank für Ihr Verständnis!",
      "topicTag": "Reisen"
    },
    {
      "id": "de-a2-p-horen-t1-gesundheit-arzt-01-s3",
      "module": "horen",
      "teil": 1,
      "level": "A2",
      "title": "Text 3",
      "text": "Liebe Hörerinnen und Hörer, heute möchten wir eine neue Apotheke vorstellen. Die Apotheke am Markt hat auch nachts geöffnet. Die Öffnungszeiten finden Sie auf der Website.",
      "topicTag": "Reisen"
    },
    {
      "id": "de-a2-p-horen-t1-gesundheit-arzt-02-s4",
      "module": "horen",
      "teil": 1,
      "level": "A2",
      "title": "Text 4",
      "text": "Hallo Frau Weber, hier ist die Zahnarztpraxis. Ihr Termin am Freitag um 14 Uhr bestätigt. Bitte kommen Sie 10 Minuten früher. Wenn Sie absagen möchten, rufen Sie bitte an unter 030-123456.",
      "topicTag": "Reisen"
    },
    {
      "id": "de-a2-p-horen-t1-gesundheit-arzt-03-s1",
      "module": "horen",
      "teil": 1,
      "level": "A2",
      "title": "Text 2",
      "text": "Guten Tag! Sie haben die Zahnarztpraxis Dr. Müller angerufen. Wir sind montags bis freitags von 8 bis 12 Uhr und von 14 bis 18 Uhr für Sie erreichbar. Am Samstag haben wir geschlossen. Bitte hinterlassen Sie eine Nachricht mit Ihrem Namen und Ihrer Telefonnummer. Wir rufen Sie schnell zurück. Danke!",
      "topicTag": "Reisen"
    },
    {
      "id": "de-a2-p-horen-t1-transport-stadtverkehr-01-s3",
      "module": "horen",
      "teil": 1,
      "level": "A2",
      "title": "Text 3",
      "text": "Guten Tag, der Ticketschalter ist momentan geschlossen. Öffnungszeiten: Montag bis Freitag 8 bis 18 Uhr. Am Wochenende ab 10 Uhr. Fahrkarten können Sie auch am Automaten kaufen.",
      "topicTag": "Reisen"
    }
